# Backend
LOG_LEVEL=info
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Postgres. Compose creates this database and user on the first start.
POSTGRES_DB=shop_crm
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_PORT=5432

# Bonus program. 1 bonus point = 1 ruble.
# Cashback is a percentage of the amount actually paid in cash, rounded down.
BONUS_CASHBACK_PERCENT=5
# A single receipt may cover at most this percentage of its subtotal with bonuses.
BONUS_SPEND_LIMIT_PERCENT=50

# Demo data (8 products, 3 customers) is applied as a migration on start.
SEED_ON_STARTUP=true